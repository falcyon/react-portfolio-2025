    {
      "sections": [
        {
          "type": "image",
          "size": "h",
          "src": "/media/gnyPoint/printed.png",
          "alt": "The printed magazine"
        },
        {
          "type": "text",
          "size": "h",
          "text": [
            "The cover features the magazine's bold custom masthead in a gradient from green to yellow, set against a vibrant cyan background with a vintage pocket watch. The typography throughout pairs bold sans-serif headings with justified serif body text for readability across long-form articles."
          ]
